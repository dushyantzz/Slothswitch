# SlothSwitch environment variables
# Copy this file to .env and fill in actual values

# --- Decision Model (Laya) ---
# No API key needed for Laya (local model).
# Set to a checkpoint name if you want to override the default.
# SLOTHSWITCH_LAYA_CHECKPOINT=convaiinnovations/laya

# --- Small LLM Provider (optional) ---
# SLOTHSWITCH_SMALL_LLM_PROVIDER=openai
# SLOTHSWITCH_SMALL_LLM_MODEL=gpt-4o-mini
# SLOTHSWITCH_SMALL_LLM_API_KEY=sk-placeholder

# --- Large/Capable LLM Provider (optional) ---
# SLOTHSWITCH_LARGE_LLM_PROVIDER=openai
# SLOTHSWITCH_LARGE_LLM_MODEL=gpt-4o
# SLOTHSWITCH_LARGE_LLM_API_KEY=sk-placeholder

# --- Telemetry ---
# SLOTHSWITCH_TELEMETRY_ENABLED=true
# SLOTHSWITCH_LOG_RAW_PROMPTS=false  # Privacy: never enable in production without review

# --- General ---
# SLOTHSWITCH_CONFIG_PATH=config/routing.yaml
# SLOTHSWITCH_ENV=development
