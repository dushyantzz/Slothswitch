# ==============================================================================
# SlothSwitch Real Verification Environment Variables Example
# ==============================================================================
# Copy this file to .env and fill in actual values.
# Never commit .env or expose tokens in public logs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hugging Face Access Token (REQUIRED for Official Google Gemma 2 2B)
# ------------------------------------------------------------------------------
# Why needed:
# - 'google/gemma-2-2b-it' is a gated repository under the Gemma Terms of Use.
# - To obtain access:
#   1. Visit: https://huggingface.co/google/gemma-2-2b-it and click "Acknowledge license".
#   2. Go to: https://huggingface.co/settings/tokens and generate a Read token.
#   3. Paste the token below:
HF_TOKEN=

# ------------------------------------------------------------------------------
# 2. Local Generative Model Selection
# ------------------------------------------------------------------------------
# Default: google/gemma-2-2b-it
# Lightweight alternative: TinyLlama/TinyLlama-1.1B-Chat-v1.0 (already cached locally)
SLOTHSWITCH_GEMMA_MODEL_ID=google/gemma-2-2b-it

# ------------------------------------------------------------------------------
# 3. GitHub Personal Access Token (RECOMMENDED for GitHub API Workflow)
# ------------------------------------------------------------------------------
# Why needed:
# - Increases rate limit from 60 requests/hr (unauthenticated) to 5,000 requests/hr.
# - Allows live testing of approval-gated mutating actions (e.g., adding labels, comments).
# - To create a least-privilege token:
#   1. Go to: https://github.com/settings/tokens (Fine-grained or Classic).
#   2. For fine-grained: Grant "Repository permissions" -> "Issues" (Read & Write), "Pull requests" (Read & Write).
#   3. Paste the token below:
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 4. Optional Designated Safe GitHub Target Repo for Live Mutating Tests
# ------------------------------------------------------------------------------
# Example: your-user/your-test-repo (prevents automated tests from touching production repos)
GITHUB_TEST_REPO=

# ------------------------------------------------------------------------------
# 5. Core Decision Model (Laya ModernBERT)
# ------------------------------------------------------------------------------
# No API key needed! Laya runs 100% locally on CPU/GPU.
SLOTHSWITCH_LAYA_CHECKPOINT=convaiinnovations/laya

# ------------------------------------------------------------------------------
# 6. General Runtime Configuration
# ------------------------------------------------------------------------------
SLOTHSWITCH_ENV=development
SLOTHSWITCH_TELEMETRY_ENABLED=true
SLOTHSWITCH_LOG_RAW_PROMPTS=false
